# ── Local (desarrollo) ────────────────────────────────
APP_NAME="Tazos Dorados API"
DEBUG=true

# Opción A: variables individuales (desarrollo local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=tazos_dorados

# Opción B: URL directa (recomendada para Render/producción)
# Si defines DATABASE_URL, las variables DB_* se ignoran
# DATABASE_URL=mysql+pymysql://usuario:password@host:3306/nombre_db

# JWT
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — acepta lista separada por comas o JSON
# Desarrollo:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Producción (ejemplo):
# CORS_ORIGINS=https://tudominio.com

# Admin endpoints
API_ADMIN_KEY=cambia-esta-clave-admin
